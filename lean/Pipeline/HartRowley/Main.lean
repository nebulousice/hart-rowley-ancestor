import Pipeline.HartRowley.Data

/-!
# Hart–Rowley Conjecture 1.3 fails in H3 (finite computation, checked by the kernel)

Source: S. B. Hart, P. J. Rowley, *A note on involution prefixes in Coxeter groups*,
arXiv:2502.00777v1, Conjecture 1.3: for finite `W`, the involution length of every
element is at most the rank.

Model. `G` = the group of permutations of the 30 roots of H3 generated by `s1 s2 s3`
(Coxeter graph `r1 -5- r2 - r3`). Checked below by `decide +kernel`:
* `s1 s2 s3` satisfy the Coxeter relations of H3 (`relations_H3`);
* the 120 listed permutations are pairwise distinct (strictly increasing), start with the
  identity, and are closed under right multiplication by the generators, with the
  multiplication table recomputed from the permutations (`table_ok`);
* breadth-first search from the identity in that Cayley graph reaches all 120 elements
  (`bfs_reaches_all`), so `G = ⟨s1,s2,s3⟩` has order 120.
Cited, not formalized: `|W(H3)| = 120` (Humphreys, *Reflection groups and Coxeter
groups*, §2.11). With the relations this makes `r_i ↦ s_i` an isomorphism
`W(H3) ≅ G`, so the Coxeter length equals the word length `bfsLen` in this Cayley graph.

Definitions follow the source literally: `u` is a prefix of `w` iff
`ℓ(u) + ℓ(u⁻¹w) = ℓ(w)`; the ancestors of `w` are the involution prefixes of maximal
length; `ℓ_inv(w) = 1 + ℓ_inv(a(w)⁻¹ w)`, `ℓ_inv(1) = 0`.
-/

namespace HartRowley

def one : List Nat := List.range 30

/-- `(mul p q) k = p (q k)`: composition, `q` first. -/
def mul (p q : List Nat) : List Nat := q.map (fun k => p.getD k 0)

def gens : List (List Nat) := [s1, s2, s3]

def ppow (p : List Nat) : Nat → List Nat
  | 0 => one
  | n + 1 => mul (ppow p n) p

/-- the element `r_{i1} ⋯ r_{ik}` (labels 1..3) -/
def evalWord (w : List Nat) : List Nat :=
  w.foldl (fun acc i => mul acc (gens.getD (i - 1) [])) one

def el (i : Nat) : List Nat := elemsData.getD i []
def idx (p : List Nat) : Nat := elemsData.findIdx (fun q => q == p)

def lexLt : List Nat → List Nat → Bool
  | [], [] => false
  | [], _ :: _ => true
  | _ :: _, [] => false
  | a :: as, b :: bs => a < b || (a == b && lexLt as bs)

def strictlySorted : List (List Nat) → Bool
  | a :: b :: rest => lexLt a b && strictlySorted (b :: rest)
  | _ => true

theorem relations_H3 :
    mul s1 s1 = one ∧ mul s2 s2 = one ∧ mul s3 s3 = one ∧
    ppow (mul s1 s2) 5 = one ∧ ppow (mul s2 s3) 3 = one ∧ ppow (mul s1 s3) 2 = one ∧
    s1 ≠ one ∧ s2 ≠ one ∧ s3 ≠ one ∧
    mul s1 s2 ≠ one ∧ ppow (mul s1 s2) 2 ≠ one ∧ ppow (mul s1 s2) 3 ≠ one ∧
    ppow (mul s1 s2) 4 ≠ one ∧ ppow (mul s2 s3) 2 ≠ one ∧ mul s2 s3 ≠ one ∧
    mul s1 s3 ≠ one := by
  decide +kernel

/-- distinct elements, identity first, table consistent with the permutations -/
theorem table_ok :
    elemsData.length = 120 ∧ strictlySorted elemsData = true ∧ el 0 = one ∧
    rightData.length = 120 ∧
    ((List.range 120).all fun i => (List.range 3).all fun j =>
        decide ((rightData.getD i []).getD j 999 < 120) &&
        el ((rightData.getD i []).getD j 999) == mul (el i) (gens.getD j [])) = true := by
  decide +kernel

def nbrs (x : Nat) : List Nat := rightData.getD x []

def bfsAux : Nat → List Nat → List Nat → List (List Nat)
  | 0, _, _ => []
  | n + 1, seen, layer =>
    if layer.isEmpty then [] else
      let seen' := seen ++ layer
      layer :: bfsAux n seen'
        ((layer.flatMap nbrs).foldl
          (fun acc y => if seen'.contains y || acc.contains y then acc else acc ++ [y]) [])

/-- BFS layers of the Cayley graph from the identity (index 0) -/
def layers : List (List Nat) := bfsAux 40 [] [0]

/-- word length = BFS distance -/
def bfsLen (x : Nat) : Nat := layers.findIdx (fun l => l.contains x)

theorem bfs_reaches_all : layers.flatten.length = 120 := by decide +kernel

/-- the hint table of lengths equals the BFS distances -/
theorem lenData_ok : lenData = (List.range 120).map bfsLen := by decide +kernel

def isInvol (i : Nat) : Bool := i != 0 && mul (el i) (el i) == one

/-- the hint list of involutions equals the involutions of `G` -/
theorem involData_ok : involData = (List.range 120).filter isInvol := by decide +kernel

def len (i : Nat) : Nat := lenData.getD i 0

/-- for an involution `u` (so `u⁻¹ = u`): `u` is a prefix of `w` iff `ℓ(u) + ℓ(u w) = ℓ(w)` -/
def isPrefixInv (u w : Nat) : Bool := len u + len (idx (mul (el u) (el w))) == len w

def involPrefixes (w : Nat) : List Nat := involData.filter (fun u => isPrefixInv u w)

def ancestors (w : Nat) : List Nat :=
  let ps := involPrefixes w
  let m := (ps.map len).foldl max 0
  ps.filter (fun u => len u == m)

/-- ancestor decomposition (list of factor indices); `none` if some ancestor is not unique -/
def decomp : Nat → Nat → Option (List Nat)
  | 0, _ => some []
  | f + 1, w =>
    if w == 0 then some [] else
      match ancestors w with
      | [a] => (decomp f (idx (mul (el a) (el w)))).map (a :: ·)
      | _ => none

def ilen (w : Nat) : Option Nat := (decomp 20 w).map List.length

def witness : Nat := idx (evalWord [2, 1, 2, 3, 1, 2, 1])

/-- The H3 witness: length 7, involution prefixes `r2, r2r1r2` only, ancestor decomposition
`(r2r1r2)(r3r1)(r2)(r1)`, so involution length 4 > 3 = rank. -/
theorem witness_facts :
    len witness = 7 ∧
    (involPrefixes witness).length = 2 ∧
    (involPrefixes witness).contains (idx (evalWord [2])) = true ∧
    (involPrefixes witness).contains (idx (evalWord [2, 1, 2])) = true ∧
    decomp 20 witness =
      some [idx (evalWord [2, 1, 2]), idx (evalWord [3, 1]), idx (evalWord [2]),
            idx (evalWord [1])] ∧
    ilen witness = some 4 := by
  decide +kernel

/-- group-wide: every non-identity element has a unique ancestor, the maximum involution
length is 4, and exactly 3 elements exceed the rank 3 -/
theorem h3_table :
    ((List.range 120).all fun w => w == 0 || (ancestors w).length == 1) = true ∧
    ((List.range 120).map fun w => (ilen w).getD 999).foldl max 0 = 4 ∧
    ((List.range 120).filter fun w => (ilen w).getD 999 > 3).length = 3 := by
  decide +kernel

theorem h3_counterexample :
    (∃ w, w < 120 ∧ ilen w = some 4 ∧ len w = 7) ∧
    ((List.range 120).filter fun w => (ilen w).getD 999 > 3).length = 3 :=
  ⟨⟨witness, by decide +kernel, witness_facts.2.2.2.2.2, witness_facts.1⟩, h3_table.2.2⟩

end HartRowley

#print axioms HartRowley.relations_H3
#print axioms HartRowley.table_ok
#print axioms HartRowley.bfs_reaches_all
#print axioms HartRowley.lenData_ok
#print axioms HartRowley.involData_ok
#print axioms HartRowley.witness_facts
#print axioms HartRowley.h3_table
#print axioms HartRowley.h3_counterexample
